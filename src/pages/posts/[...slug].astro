---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  basePath,
  formatDate,
  getPostDescription,
  getPostTags,
  getTagUrl,
  isRenderablePost,
  isPublicPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => isPublicPost(post) && isRenderablePost(post));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const baseUrl = basePath();
const visibleHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth <= 3 && heading.slug !== 'footnote-label');
---

<Layout title={post.data.title} description={getPostDescription(post)}>
  <div class="reading-progress" id="progress-bar"></div>

  <main class="article-shell">
    <header class="topbar article-topbar">
      <a class="brand" href={baseUrl}>杨几安</a>
      <nav class="nav-links" aria-label="主导航">
        <a href={baseUrl}>首页</a>
        <a href={`${baseUrl}collections`}>合集</a>
        <a href={`${baseUrl}#notes`}>笔记</a>
      </nav>
    </header>

    <div class="article-layout">
      <aside class="toc-panel" aria-label="文章目录">
        {visibleHeadings.length > 0 && (
          <>
            <p class="eyebrow">On this page</p>
            <nav>
              {visibleHeadings.map((heading) => (
                <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </>
        )}
      </aside>

      <article class="article-main">
        <header class="article-header">
          <div class="note-tags">
            {getPostTags(post).map((tag) => (
              <a href={getTagUrl(tag)}>{tag}</a>
            ))}
          </div>
          <h1>{post.data.title}</h1>
          <div class="article-meta">
            <time>{formatDate(post.data.date)}</time>
            {post.data.featured && <span>Featured</span>}
          </div>
          <p>{getPostDescription(post)}</p>
        </header>

        <div class="article-card">
          <div class="prose prose-slate max-w-none article-prose">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<script>
  const progressBar = document.getElementById('progress-bar');

  const updateProgress = () => {
    if (!progressBar) return;
    const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    progressBar.style.width = height > 0 ? `${(scrollTop / height) * 100}%` : '0%';
  };

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  const buildCitationRail = () => {
    const article = document.querySelector('.article-prose');
    if (!article) return;

    type CitationItem =
      { type: 'footnote'; number: string; html: string; href?: string } |
      { type: 'link'; label: string; text: string; href: string };

    type CollectedCitations = {
      items: CitationItem[];
      footnoteRefs: HTMLAnchorElement[];
    };

    const footnotes = Array.from(article.querySelectorAll('.footnotes ol > li[id]'));
    const footnoteItems = new Map<string, CitationItem>();
    footnotes.forEach((note, index) => {
      const clonedNote = note.cloneNode(true) as HTMLElement;
      clonedNote.querySelectorAll('.footnote-backref, [data-footnote-backref]').forEach((backref) => backref.remove());
      const key = note.id.replace(/^user-content-fn-/, '').replace(/^fn-/, '');
      footnoteItems.set(key, {
        type: 'footnote',
        number: String(index + 1),
        html: clonedNote.innerHTML,
        href: `#${note.id}`,
      });
    });

    const collectCitations = (container: HTMLElement): CollectedCitations => {
      const items: CitationItem[] = [];
      const footnoteRefs: HTMLAnchorElement[] = [];
      const seen = new Set<string>();

      container.querySelectorAll<HTMLAnchorElement>('sup a[href^="#fn"], sup a[data-footnote-ref]').forEach((ref) => {
        const noteKey = ref
          .getAttribute('href')
          ?.replace(/^#user-content-fn-/, '')
          .replace(/^#fn-/, '');
        if (!noteKey) return;
        footnoteRefs.push(ref);
        if (seen.has(`fn-${noteKey}`)) return;
        const item = footnoteItems.get(noteKey);
        if (!item) return;
        seen.add(`fn-${noteKey}`);
        items.push(item);
      });

      container.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
        if (link.closest('sup')) return;
        const href = link.getAttribute('href') || '';
        if (!href || seen.has(href)) return;
        seen.add(href);
        items.push({
          type: 'link',
          label: String(externalLinkIndex++).padStart(2, '0'),
          text: link.textContent?.trim() || href,
          href,
        });
      });

      return { items, footnoteRefs };
    };

    const createSidenote = (items: CitationItem[]) => {
      const aside = document.createElement('aside');
      aside.className = 'inline-citation';
      aside.setAttribute('aria-label', '本段引用来源');

      items.forEach((item) => {
        const entry = document.createElement('a');
        entry.className = 'inline-citation-item';
        if (item.type === 'footnote') {
          entry.href = item.href || '#';
          entry.innerHTML = `<span>[${item.number}]</span><div>${item.html}</div>`;
        } else {
          entry.href = item.href;
          entry.target = '_blank';
          entry.rel = 'noreferrer';
          entry.innerHTML = `<span>${item.label}</span><div>${item.text}</div>`;
        }
        aside.append(entry);
      });

      return aside;
    };

    const citationAnchors = new Map<HTMLElement, HTMLElement>();
    let citationOccurrence = 0;

    const attachSidenote = (
      anchor: HTMLElement,
      host: HTMLElement,
      citations: CollectedCitations,
      className?: string,
    ) => {
      if (!citations.items.length) return;
      const aside = createSidenote(citations.items);
      if (className) aside.classList.add(className);
      aside.id = `inline-citation-${++citationOccurrence}`;
      citations.footnoteRefs.forEach((ref) => ref.setAttribute('href', `#${aside.id}`));
      citationAnchors.set(aside, anchor);
      host.append(aside);
    };

    const stackSidenotes = () => {
      const notes = Array.from(article.querySelectorAll<HTMLElement>('.inline-citation'));
      if (window.matchMedia('(max-width: 900px)').matches) {
        notes.forEach((note) => note.style.top = '');
        return;
      }

      let lastBottom = 0;
      const gap = 14;

      notes
        .map((note) => {
          const anchor = citationAnchors.get(note) || note.closest<HTMLElement>('.has-inline-citation');
          return { note, anchor, top: anchor?.getBoundingClientRect().top ?? note.getBoundingClientRect().top };
        })
        .sort((a, b) => a.top - b.top)
        .forEach(({ note, anchor }) => {
          if (!anchor) return;
          note.style.transform = '';
          note.style.top = '';
          const anchorTop = anchor.getBoundingClientRect().top + window.scrollY;
          const offsetParent = note.offsetParent as HTMLElement | null;
          const parentTop = offsetParent
            ? offsetParent.getBoundingClientRect().top + window.scrollY
            : anchorTop;
          const desiredTop = Math.max(anchorTop, lastBottom + gap);
          note.style.top = `${Math.max(0, desiredTop - parentTop)}px`;
          lastBottom = desiredTop + note.offsetHeight;
        });
    };

    let externalLinkIndex = 1;
    const citedBlocks = Array.from(article.querySelectorAll('p, li, blockquote'));

    citedBlocks.forEach((block) => {
      if (block.closest('.footnotes')) return;
      const blockElement = block as HTMLElement;
      const citations = collectCitations(blockElement);
      if (!citations.items.length) return;
      blockElement.classList.add('has-inline-citation');
      attachSidenote(blockElement, blockElement, citations);
    });

    article.querySelectorAll<HTMLElement>('table').forEach((table) => {
      const citedRows = Array.from(table.querySelectorAll<HTMLElement>('tr'))
        .map((row) => ({ row, citations: collectCitations(row) }))
        .filter(({ citations }) => citations.items.length > 0);
      if (!citedRows.length) return;

      const frame = document.createElement('div');
      frame.className = 'table-citation-frame';
      table.before(frame);
      frame.append(table);

      citedRows.forEach(({ row, citations }) => {
        row.classList.add('has-table-citation');
        attachSidenote(row, frame, citations, 'table-row-citation');
      });
    });

    article.classList.add('has-citation-rail');
    stackSidenotes();

    window.addEventListener('resize', stackSidenotes, { passive: true });
    if ('fonts' in document) {
      document.fonts.ready.then(stackSidenotes);
    }
  };

  buildCitationRail();
</script>
