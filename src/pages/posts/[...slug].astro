---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  basePath,
  formatDate,
  getPostDescription,
  getPostTags,
  getTagUrl,
  isRenderablePost,
  isPublicPost,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => isPublicPost(post) && isRenderablePost(post));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const baseUrl = basePath();
const visibleHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth <= 3 && heading.slug !== 'footnote-label');
---

<Layout title={post.data.title} description={getPostDescription(post)}>
  <div class="reading-progress" id="progress-bar"></div>

  <main class="article-shell">
    <header class="topbar article-topbar">
      <a class="brand" href={baseUrl}>杨几安</a>
      <nav class="nav-links" aria-label="主导航">
        <a href={baseUrl}>首页</a>
        <a href={`${baseUrl}collections`}>合集</a>
        <a href={`${baseUrl}#notes`}>笔记</a>
      </nav>
    </header>

    <div class="article-layout">
      <aside class="toc-panel" aria-label="文章目录">
        {visibleHeadings.length > 0 && (
          <>
            <p class="eyebrow">On this page</p>
            <nav>
              {visibleHeadings.map((heading) => (
                <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
              ))}
            </nav>
          </>
        )}
      </aside>

      <article class="article-main">
        <header class="article-header">
          <div class="note-tags">
            {getPostTags(post).map((tag) => (
              <a href={getTagUrl(tag)}>{tag}</a>
            ))}
          </div>
          <h1>{post.data.title}</h1>
          <div class="article-meta">
            <time>{formatDate(post.data.date)}</time>
            {post.data.featured && <span>Featured</span>}
          </div>
          <p>{getPostDescription(post)}</p>
        </header>

        <div class="article-card">
          <div class="prose prose-slate max-w-none article-prose">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<script>
  const progressBar = document.getElementById('progress-bar');

  const updateProgress = () => {
    if (!progressBar) return;
    const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    progressBar.style.width = height > 0 ? `${(scrollTop / height) * 100}%` : '0%';
  };

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  const buildCitationRail = () => {
    const article = document.querySelector('.article-prose');
    if (!article) return;

    type CitationItem =
      { type: 'footnote'; number: string; html: string; href?: string } |
      { type: 'link'; label: string; text: string; href: string };

    const footnotes = Array.from(article.querySelectorAll('.footnotes ol > li[id]'));
    const footnoteItems = new Map<string, CitationItem>();
    footnotes.forEach((note, index) => {
      const clonedNote = note.cloneNode(true) as HTMLElement;
      clonedNote.querySelectorAll('.footnote-backref, [data-footnote-backref]').forEach((backref) => backref.remove());
      const number = note.id.match(/\d+/)?.[0] || String(index + 1);
      footnoteItems.set(number, {
        type: 'footnote',
        number,
        html: clonedNote.innerHTML,
        href: `#${note.id}`,
      });
    });

    const createSidenote = (items: CitationItem[]) => {
      const aside = document.createElement('aside');
      aside.className = 'inline-citation';
      aside.setAttribute('aria-label', '本段引用来源');

      items.forEach((item) => {
        const entry = document.createElement('a');
        entry.className = 'inline-citation-item';
        if (item.type === 'footnote') {
          entry.href = item.href || '#';
          entry.innerHTML = `<span>[${item.number}]</span><div>${item.html}</div>`;
        } else {
          entry.href = item.href;
          entry.target = '_blank';
          entry.rel = 'noreferrer';
          entry.innerHTML = `<span>${item.label}</span><div>${item.text}</div>`;
        }
        aside.append(entry);
      });

      return aside;
    };

    let externalLinkIndex = 1;
    const citedBlocks = Array.from(article.querySelectorAll('p, li, blockquote'));

    citedBlocks.forEach((block) => {
      if (block.closest('.footnotes')) return;
      const blockElement = block as HTMLElement;
      const items: CitationItem[] = [];
      const seen = new Set<string>();

      blockElement.querySelectorAll('sup a[href^="#fn"], sup a[data-footnote-ref]').forEach((ref) => {
        const noteNumber = ref.getAttribute('href')?.match(/\d+/)?.[0];
        if (!noteNumber || seen.has(`fn-${noteNumber}`)) return;
        const item = footnoteItems.get(noteNumber);
        if (!item) return;
        seen.add(`fn-${noteNumber}`);
        items.push(item);
        ref.setAttribute('href', `#inline-fn-${noteNumber}`);
      });

      blockElement.querySelectorAll('a[href^="http"]').forEach((link) => {
        if (link.closest('sup')) return;
        const href = link.getAttribute('href') || '';
        if (!href || seen.has(href)) return;
        seen.add(href);
        items.push({
          type: 'link',
          label: String(externalLinkIndex++).padStart(2, '0'),
          text: link.textContent?.trim() || href,
          href,
        });
      });

      if (!items.length) return;
      blockElement.classList.add('has-inline-citation');
      const aside = createSidenote(items);
      const firstFootnote = items.find((item): item is Extract<CitationItem, { type: 'footnote' }> => item.type === 'footnote');
      if (firstFootnote) aside.id = `inline-fn-${firstFootnote.number}`;
      blockElement.append(aside);
    });

    article.classList.add('has-citation-rail');
  };

  buildCitationRail();
</script>
