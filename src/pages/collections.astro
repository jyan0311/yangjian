---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {
  basePath,
  formatDate,
  getPostDescription,
  getPostUrl,
  getTagUrl,
  getTopicGroups,
  isRenderablePost,
  isPublicPost,
} from '../lib/posts';

const posts = (await getCollection('posts')).filter((post) => isPublicPost(post) && isRenderablePost(post));
const groupedPosts = Object.entries(getTopicGroups(posts)).sort((a, b) => b[1].length - a[1].length);
const baseUrl = basePath();
---

<Layout title="主题合集 | 杨几安的研究主页" description="按主题整理的研究笔记合集。">
  <main class="site-shell">
    <header class="topbar">
      <a class="brand" href={baseUrl}>杨几安</a>
      <nav class="nav-links" aria-label="主导航">
        <a href={baseUrl}>首页</a>
        <a href={`${baseUrl}#notes`}>笔记</a>
        <a href={`${baseUrl}#tags`}>标签</a>
      </nav>
    </header>

    <section class="page-hero">
      <p class="eyebrow">Collections</p>
      <h1>主题合集</h1>
      <p>把零散笔记按研究问题重新归档。每个主题下按时间倒序排列，方便从最新实验回溯到基础材料。</p>
    </section>

    <section class="collection-list">
      {groupedPosts.map(([topic, topicPosts]) => (
        <section class="collection-section" id={encodeURIComponent(topic)}>
          <div class="collection-heading">
            <div>
              <p class="eyebrow">{topicPosts.length} notes</p>
              <h2>{topic}</h2>
            </div>
            <a href={`${baseUrl}#topics`}>返回主题地图</a>
          </div>

          <div class="note-list compact">
            {topicPosts.map((post) => (
              <article class="note-row">
                <div class="note-row-date">
                  <time>{formatDate(post.data.date)}</time>
                </div>
                <div>
                  <div class="note-tags">
                    {post.data.tags.slice(0, 4).map((tag) => (
                      <a href={getTagUrl(tag)}>{tag}</a>
                    ))}
                  </div>
                  <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
                  <p>{getPostDescription(post)}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </section>
  </main>
</Layout>
