---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import {
  formatDate,
  getAllTags,
  getPostDescription,
  getPostUrl,
  getTagUrl,
  getTopicGroups,
  isRenderablePost,
  isPublicPost,
  sortByDateDesc,
} from '../lib/posts';

const allPosts = (await getCollection('posts')).filter((post) => isPublicPost(post) && isRenderablePost(post));
const posts = sortByDateDesc(allPosts);
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const recentPosts = posts.slice(0, 8);
const topicGroups = getTopicGroups(posts);
const topTopics = Object.entries(topicGroups).sort((a, b) => b[1].length - a[1].length);
const tags = getAllTags(posts);
const latestPost = posts[0];
const activeSince = posts[posts.length - 1];
---

<Layout title="杨几安的研究主页" description="杨几安的个人主页、研究笔记与量化/LLM 数字花园。">
  <main class="site-shell">
    <header class="topbar">
      <a class="brand" href={import.meta.env.BASE_URL}>杨几安</a>
      <nav class="nav-links" aria-label="主导航">
        <a href="#notes">笔记</a>
        <a href="#topics">主题</a>
        <a href="#tags">标签</a>
        <a href="https://github.com/pangxianyuy" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Monash AI Student · LLM · Quant Research</p>
        <h1>把研究、实验和代码复盘整理成可继续生长的知识库。</h1>
        <p class="hero-text">
          这里主要记录 LLM 推理与蒸馏、量化 Alpha 因子挖掘、Qlib 回测系统、多智能体框架，以及工作中的实验复盘。页面的目标不是可爱装饰，而是让笔记更容易被重新找到、串起来、继续写下去。
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#notes">浏览最新笔记</a>
          <a class="button secondary" href={`${import.meta.env.BASE_URL}collections`}>查看主题合集</a>
        </div>
      </div>

      <aside class="profile-panel" aria-label="主页概览">
        <img src={`${import.meta.env.BASE_URL}images/usagi-face.png`} alt="个人头像" />
        <dl>
          <div>
            <dt>笔记总数</dt>
            <dd>{posts.length}</dd>
          </div>
          <div>
            <dt>主题数</dt>
            <dd>{topTopics.length}</dd>
          </div>
          <div>
            <dt>最新更新</dt>
            <dd>{formatDate(latestPost?.data.date)}</dd>
          </div>
          <div>
            <dt>开始整理</dt>
            <dd>{formatDate(activeSince?.data.date)}</dd>
          </div>
        </dl>
      </aside>
    </section>

    {featuredPosts.length > 0 && (
      <section class="section-block">
        <div class="section-heading">
          <p class="eyebrow">Featured</p>
          <h2>优先阅读</h2>
        </div>
        <div class="featured-grid">
          {featuredPosts.map((post) => (
            <article class="note-card featured-card">
              <div class="note-meta">
                <time>{formatDate(post.data.date)}</time>
                <span>{post.data.tags[0]}</span>
              </div>
              <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
              <p>{getPostDescription(post)}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section id="topics" class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Map</p>
        <h2>按研究主题进入</h2>
      </div>
      <div class="topic-grid">
        {topTopics.map(([topic, group]) => (
          <a class="topic-card" href={`${import.meta.env.BASE_URL}collections#${encodeURIComponent(topic)}`}>
            <span>{topic}</span>
            <strong>{group.length} 篇</strong>
            <small>{group[0].data.title}</small>
          </a>
        ))}
      </div>
    </section>

    <section id="notes" class="section-block notes-layout">
      <div class="section-heading sticky-heading">
        <p class="eyebrow">Latest</p>
        <h2>最近笔记</h2>
        <p>按更新时间排列，适合快速回到正在推进的问题。</p>
      </div>

      <div class="note-list">
        {recentPosts.map((post) => (
          <article class="note-row">
            <div class="note-row-date">
              <time>{formatDate(post.data.date)}</time>
            </div>
            <div>
              <div class="note-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <a href={getTagUrl(tag)}>{tag}</a>
                ))}
              </div>
              <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
              <p>{getPostDescription(post)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="tags" class="section-block">
      <div class="section-heading">
        <p class="eyebrow">Index</p>
        <h2>标签索引</h2>
      </div>
      <div class="tag-cloud">
        {tags.map((tag) => (
          <a href={getTagUrl(tag)}>{tag}</a>
        ))}
      </div>
    </section>
  </main>
</Layout>
