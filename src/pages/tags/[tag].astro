---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {
  basePath,
  formatDate,
  getAllTags,
  getNavigationTags,
  getPostTags,
  getPostDescription,
  getPostUrl,
  getTagUrl,
  isRenderablePost,
  isPublicPost,
  slugifyTag,
  sortByDateDesc,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => isPublicPost(post) && isRenderablePost(post));
  const allTags = getAllTags(posts);

  return allTags.map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: sortByDateDesc(posts.filter((post) => getPostTags(post).includes(tag))),
      allTags,
    },
  }));
}

const { tag, posts, allTags } = Astro.props;
const baseUrl = basePath();
const relatedTags = getNavigationTags(posts, 18).filter(({ tag: item }) => item !== tag);
const fallbackTags = allTags.filter((item: string) => item !== tag).slice(0, 18);
---

<Layout title={`${tag} | 杨几安的研究主页`} description={`标签 ${tag} 下的研究笔记。`}>
  <main class="site-shell">
    <header class="topbar">
      <a class="brand" href={baseUrl}>杨几安</a>
      <nav class="nav-links" aria-label="主导航">
        <a href={baseUrl}>首页</a>
        <a href={`${baseUrl}collections`}>合集</a>
        <a href={`${baseUrl}#tags`}>标签</a>
      </nav>
    </header>

    <section class="page-hero">
      <p class="eyebrow">Tag</p>
      <h1>{tag}</h1>
      <p>这个标签下有 {posts.length} 篇笔记。适合顺着同一概念、方法或实验线索继续读。</p>
    </section>

    <section class="notes-layout single-column">
      <div class="note-list">
        {posts.map((post) => (
          <article class="note-row">
            <div class="note-row-date">
              <time>{formatDate(post.data.date)}</time>
            </div>
            <div>
              <div class="note-tags">
                {getPostTags(post).slice(0, 4).map((postTag: string) => (
                  <a class={postTag === tag ? 'active' : ''} href={getTagUrl(postTag)}>{postTag}</a>
                ))}
              </div>
              <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
              <p>{getPostDescription(post)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="eyebrow">More</p>
        <h2>其他标签</h2>
      </div>
      <div class="tag-cloud">
        {relatedTags.length > 0
          ? relatedTags.map(({ tag: relatedTag, count }) => (
              <a href={getTagUrl(relatedTag)}>{relatedTag}<span>{count}</span></a>
            ))
          : fallbackTags.map((relatedTag: string) => (
              <a href={getTagUrl(relatedTag)}>{relatedTag}</a>
            ))}
      </div>
    </section>
  </main>
</Layout>
